{
  "manifest_version": 3,
  "name": "ShareGPT Export",
  "version": "1.1.0",
  "description": "Udostępnia i eksportuje rozmowy oraz pojedyncze wypowiedzi z ChatGPT jako responsywny HTML lub Markdown.",
  "permissions": [
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://ship.page/*",
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://*.oaiusercontent.com/*",
    "https://*.oaistatic.com/*",
    "https://*.openai.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/exporter.js",
        "src/annotations-compat.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
